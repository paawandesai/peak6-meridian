{
  "name": "TSLA close Tiingo",
  "ticker": "TSLA",
  "source": "tiingo",
  "jobs": [
    {
      "tasks": [
        {
          "httpTask": {
            "url": "https://api.tiingo.com/tiingo/daily/tsla/prices",
            "method": "METHOD_GET",
            "headers": [
              {
                "key": "Authorization",
                "value": "Token ${TIINGO_API_KEY}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ]
          }
        },
        {
          "jsonParseTask": {
            "path": "$[0].close"
          }
        }
      ]
    }
  ]
}
