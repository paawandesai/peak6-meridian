{
  "name": "GOOGL close Twelve Data",
  "ticker": "GOOGL",
  "source": "twelvedata",
  "jobs": [
    {
      "tasks": [
        {
          "httpTask": {
            "url": "https://api.twelvedata.com/eod?symbol=GOOGL&exchange=NASDAQ",
            "method": "METHOD_GET",
            "headers": [
              {
                "key": "Authorization",
                "value": "apikey ${TWELVEDATA_API_KEY}"
              }
            ]
          }
        },
        {
          "jsonParseTask": {
            "path": "$.close"
          }
        }
      ]
    }
  ]
}
