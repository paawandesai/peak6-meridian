# OWNER: shared. Operator may update to match reality; every change is logged in docs/decisions.md.
# Copy to .env (gitignored). Placeholder values only. Never put real secrets in this file.
# Variable meanings: docs/environment.md

SOLANA_CLUSTER=localnet
SOLANA_RPC_URL=http://127.0.0.1:8899
SOLANA_WS_URL=ws://127.0.0.1:8900

# P0-5: RPC proxy fallback (optional). Rotates to this URL on 429/5xx from primary.
# Production: a different provider (QuickNode/Alchemy) for redundancy.
SOLANA_RPC_URL_FALLBACK=

MERIDIAN_PROGRAM_ID=
USDC_MINT=

PROGRAM_KEYPAIR_PATH=~/.config/meridian/program.json
ADMIN_KEYPAIR_PATH=~/.config/meridian/admin.json
PROGRAM_KEYPAIR_PATH=~/.config/meridian/program.json
FAUCET_PUBKEY=
AUTOMATION_PUBKEY=
AUTOMATION_KEYPAIR=
MARKET_MAKER_KEYPAIR=
FAUCET_KEYPAIR=
FAUCET_AMOUNT_USDC=1000
FAUCET_MIN_LAMPORTS=100000000
FAUCET_ALERT_COOLDOWN_SEC=3600
AUTOMATION_PUBKEY=
FAUCET_PUBKEY=

SWITCHBOARD_QUEUE=
SWITCHBOARD_FEEDS_JSON={}

TIINGO_API_KEY=test-tiingo-key
TWELVEDATA_API_KEY=test-twelvedata-key
