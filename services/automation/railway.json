{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "corepack pnpm install --frozen-lockfile --filter automation..."
  },
  "deploy": {
    "startCommand": "cd services/automation && ./node_modules/.bin/tsx src/main.ts",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
