{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "uv sync --locked --package meridian_quant --no-dev --no-editable"
  },
  "deploy": {
    "startCommand": "sh -c 'QUANT_HOST=0.0.0.0 QUANT_PORT=${PORT:-4100} exec /app/.venv/bin/python -m meridian_quant.mm.main'",
    "healthcheckPath": "/health",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
