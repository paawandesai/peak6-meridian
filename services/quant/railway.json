{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "nixpacksPlan": {
      "phases": {
        "setup": {
          "nixPkgs": ["python312", "uv"]
        },
        "install": {
          "cmds": ["uv sync --frozen --no-dev --package meridian_quant"]
        }
      }
    }
  },
  "deploy": {
    "startCommand": "uv run --frozen --package meridian_quant python -m meridian_quant.server",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
