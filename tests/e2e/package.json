{
  "name": "e2e",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "End-to-end smoke against a local validator",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lifecycle": "tsx src/lifecycle.ts",
    "rehearsal": "tsx --env-file-if-exists=../../.env src/lifecycle.ts --cluster devnet",
    "coverage-window": "tsx --env-file-if-exists=../../.env src/coverage-window.ts",
    "settlement-evidence": "tsx --env-file-if-exists=../../.env src/settlement-evidence.ts"
  },
  "dependencies": {
    "@coral-xyz/anchor": "0.31.1",
    "@meridian/client": "workspace:*",
    "@solana/spl-token": "0.4.15",
    "@solana/web3.js": "1.99.0",
    "automation": "workspace:*",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "fast-check": "4.10.2",
    "tsx": "4.23.15"
  }
}
